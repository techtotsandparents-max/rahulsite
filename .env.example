# ═══════════════════════════════════════════════════════════
# RahulTripathi.dev — Environment Variables Template
# Copy to .env.local and fill in actual values.
# NEVER commit .env.local to git — it is gitignored.
# ═══════════════════════════════════════════════════════════

# ─── NextAuth Core ───────────────────────────────────────
# Required: random 32+ byte string. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Admin Access Control ────────────────────────────────
# Comma-separated list of email addresses that have admin access
ADMIN_EMAILS=

# ─── Google OAuth Provider (Optional) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Azure AD OAuth Provider (Optional) ─────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# ─── Azure Cosmos DB (MongoDB API) ───────────────────────
# Connection string from Azure Portal → Cosmos DB → Settings → Connection Strings
COSMOS_DB_CONNECTION_STRING=
COSMOS_DB_NAME=rahultech_prod

# ─── Azure Blob Storage ─────────────────────────────────
# Connection string from Azure Portal → Storage Account → Access Keys
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
AZURE_STORAGE_CDN_URL=

# ─── Azure Key Vault (Production Only) ──────────────────
# When deployed to Azure Web App, secrets are injected via
# Key Vault references in App Settings. These are NOT needed
# locally — they override the above when present.
# AZURE_KEYVAULT_URI=https://kv-rahulsite-prod.vault.azure.net/
